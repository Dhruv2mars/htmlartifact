{
  "name": "htmlartifact",
  "version": "0.1.0",
  "description": "Publish HTML artifacts from coding agents to your workspace. Only workspace members can open them.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dhruv2mars/htmlartifact.git"
  },
  "files": [
    "dist/",
    "README.md",
    "NOTICE",
    "LICENSE"
  ],
  "bin": {
    "htmlartifact": "./dist/htmlartifact.js"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "bun scripts/deploy.ts",
    "build": "bun build cli/main.ts --target=node --minify-syntax --minify-whitespace --outfile dist/htmlartifact.js",
    "build:binaries": "bun build cli/main.ts --compile --outfile release/htmlartifact",
    "typecheck:cli": "tsc -p cli/tsconfig.json",
    "pretest": "bun run build && bun run build:web",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun run test:d1 && bun run test:r2",
    "test:d1": "HTMLARTIFACT_TEST_STORAGE=d1 node --test --test-concurrency=1 test/*.test.js",
    "test:r2": "HTMLARTIFACT_TEST_STORAGE=r2 node --test --test-concurrency=1 test/*.test.js",
    "prepublishOnly": "bun run build",
    "dev:local": "node scripts/dev-local.mjs",
    "build:pages": "bun scripts/build-pages.ts",
    "deploy:all": "bun scripts/deploy.ts",
    "smoke": "bun scripts/smoke.ts",
    "migrate:r2": "bun scripts/migrate-blobs-to-r2.ts",
    "build:web": "react-router typegen web && react-router build web",
    "dev:web": "react-router dev web",
    "typecheck:web": "react-router typegen web && tsc -p web/tsconfig.json"
  },
  "engines": {
    "node": ">=20.10"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@cloudflare/workers-types": "^5.20261018.1",
    "@effect/platform-node": "^4.0.5",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@fontsource/archivo": "^5.3.0",
    "@react-router/dev": "^8.4.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@workos-inc/node": "^11.0.0",
    "@workos/emulate": "^0.15.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "effect": "^4.0.5",
    "entities": "6.0.1",
    "hono": "^4.13.13",
    "isbot": "^5.2.2",
    "jose": "^6.2.3",
    "motion": "^14.3.0",
    "nanoid": "^5.1.5",
    "next-themes": "^0.4.6",
    "parse5": "7.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "satori": "^0.62.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.151.1"
  }
}
