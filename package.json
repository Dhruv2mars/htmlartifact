{
  "name": "htmlartifact",
  "version": "0.1.0",
  "description": "Publish HTML artifacts from coding agents to your workspace. Only workspace members can open them.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dhruv2mars/htmlartifact.git"
  },
  "files": [
    "bin/",
    "src/html-policy.js",
    "README.md",
    "NOTICE"
  ],
  "bin": {
    "htmlartifact": "./bin/htmlartifact.js"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "dev:local": "node scripts/dev-local.mjs"
  },
  "engines": {
    "node": ">=20.10"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "parse5": "^7.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261018.1",
    "@types/node": "^26.6.5",
    "@workos-inc/node": "^11.0.0",
    "@workos/emulate": "^0.15.0",
    "hono": "^4.13.13",
    "jose": "^6.2.3",
    "nanoid": "^5.1.5",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.1"
  }
}
