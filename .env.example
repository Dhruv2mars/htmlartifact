# Public origin of this server. Use https://*.artifacts.example.com for one
# subdomain per artifact (needs wildcard DNS + TLS).
HTMLARTIFACT_PUBLIC_BASE_URL=https://artifacts.example.com

# 32+ random characters: openssl rand -base64 48
HTMLARTIFACT_COOKIE_PASSWORD=

# WorkOS dashboard → API Keys
WORKOS_API_KEY=sk_live_...
WORKOS_CLIENT_ID=client_...
# WorkOS dashboard → Webhooks (endpoint: <public url>/webhooks/workos)
WORKOS_WEBHOOK_SECRET=

DATABASE_URL=postgres://localhost:5432/htmlartifact

# Disk storage or an S3-compatible bucket.
HTMLARTIFACT_STORAGE_DIR=./data/artifacts
# AWS_S3_BUCKET_NAME=
# AWS_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto

# Optional
# HTMLARTIFACT_PUBLISH_PERMISSION=artifacts:publish
# HTMLARTIFACT_ALLOW_TEAM_CREATION=false
# HTMLARTIFACT_AUDIT_LOGS=true
